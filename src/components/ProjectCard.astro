---
import type { ProjectMeta } from '../data/projects';
import type { RepoStats } from '../lib/github';

interface Props {
	project: ProjectMeta;
	stats: RepoStats;
}

const { project, stats } = Astro.props;
---

<article class="panel card lift" data-reveal>
	<div class="card-head">
		<h3>{project.name}</h3>
		{
			stats.stars > 0 && (
				<span class="stars" title={`${stats.stars} GitHub stars`}>
					★ {stats.stars}
				</span>
			)
		}
	</div>
	<p class="role">{project.role}</p>
	<p class="blurb">{project.blurb}</p>
	<ul class="tag-list">
		{
			[
				...new Set([
					...(stats.language ? [stats.language] : []),
					...project.tags,
				]),
			].map((tag) => <li class="tag">{tag}</li>)
		}
	</ul>
	<div class="links">
		{
			project.sourcePrivate ? (
				<span
					class="btn btn-disabled has-tooltip"
					aria-disabled="true"
					aria-label="This repo is private, so the source isn't public"
					tabindex="0"
				>
					<svg
						class="icon-lock"
						viewBox="0 0 16 16"
						width="13"
						height="13"
						aria-hidden="true"
					>
						<rect
							x="3.25"
							y="7.25"
							width="9.5"
							height="6.5"
							rx="1.25"
							fill="none"
							stroke="currentColor"
							stroke-width="1.3"
						/>
						<path
							d="M5.5 7.25V5.25a2.5 2.5 0 0 1 5 0v2"
							fill="none"
							stroke="currentColor"
							stroke-width="1.3"
							stroke-linecap="round"
						/>
					</svg>
					Source
					<span class="tooltip-bubble" aria-hidden="true">
						This repo is private, so the source isn't public
					</span>
				</span>
			) : (
				<a class="btn" href={project.href} target="_blank" rel="noreferrer">
					Source
				</a>
			)
		}
		{
			project.extraHref && (
				<a
					class="btn"
					href={project.extraHref.href}
					target="_blank"
					rel="noreferrer"
				>
					{project.extraHref.label}
				</a>
			)
		}
	</div>
</article>

<style>
	.card {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.card-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.card-head h3 {
		margin: 0;
		font-size: 1.1rem;
		color: var(--fg);
	}

	.stars {
		font-size: 0.85rem;
		color: var(--accent-amber);
		white-space: nowrap;
	}

	.role {
		margin: 0;
		font-size: 0.8rem;
		color: var(--fg-faint);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.blurb {
		margin: 0;
		flex: 1;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.25rem;
	}

	/* Dimmed via color, not opacity: opacity < 1 flattens the whole subtree
	   into one compositing group, which was dragging the tooltip's own
	   opacity down with it even though the tooltip escapes this box via
	   overflow:visible. overflow has to be visible so the tooltip below
	   isn't clipped by the button's own bounds. */
	.btn-disabled {
		color: var(--fg-faint);
		cursor: not-allowed;
		overflow: visible;
	}

	.btn-disabled:hover,
	.btn-disabled:focus-visible {
		background: rgba(61, 220, 132, 0.06);
		border-color: var(--border);
		color: var(--fg-faint);
	}

	.btn-disabled::before {
		/* No shine sweep on a disabled, non-interactive element. */
		display: none;
	}

	.icon-lock {
		flex-shrink: 0;
	}

	/* Real element rather than a ::after, since the button already uses
	   ::before for its shine layer. */
	.has-tooltip {
		position: relative;
	}

	.tooltip-bubble {
		position: absolute;
		bottom: calc(100% + 9px);
		left: 50%;
		transform: translateX(-50%) translateY(4px);
		white-space: nowrap;
		/* Fully opaque background, not translucent like the nav bar: this
		   tooltip sits directly over other cards' text, and any see-through
		   was enough to visibly ghost it. */
		background: rgba(6, 9, 7, 1);
		color: var(--fg);
		border: 1px solid var(--border);
		border-radius: 3px;
		padding: 0.4rem 0.65rem;
		font-size: 0.72rem;
		font-family: var(--font-mono);
		/* No transition on opacity/visibility, only on the slide, so it never shows a half-transparent frame. */
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: transform 0.15s ease;
		z-index: 30;
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.has-tooltip:hover .tooltip-bubble,
	.has-tooltip:focus-visible .tooltip-bubble {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.tooltip-bubble {
			transition: none;
			transform: translateX(-50%);
		}
	}

	/* Centering the tooltip pushes it off the left edge on narrow screens,
	   so anchor to the button's left edge instead and let it wrap. */
	@media (max-width: 30rem) {
		.tooltip-bubble {
			left: 0;
			transform: translateY(4px);
			white-space: normal;
			width: max-content;
			max-width: min(220px, calc(100vw - 3rem));
		}

		.has-tooltip:hover .tooltip-bubble,
		.has-tooltip:focus-visible .tooltip-bubble {
			transform: translateY(0);
		}
	}
</style>
