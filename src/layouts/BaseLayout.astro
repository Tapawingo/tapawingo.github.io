---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

import PlasmaBackground from '../components/PlasmaBackground.astro';
import LenisScroll from '../components/LenisScroll.astro';
import ScrollEffects from '../components/ScrollEffects.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PerfOverlay from '../components/PerfOverlay.astro';

interface Props {
	title: string;
	description: string;
	/** Set on pages that shouldn't be indexed, e.g. 404. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.jpg', Astro.site);

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Eirik Dalsegg Teppen',
	url: Astro.site?.toString(),
	image: ogImageURL.toString(),
	jobTitle: 'Software Developer',
	nationality: {
		'@type': 'Country',
		name: 'Norway',
	},
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Norwegian University of Science and Technology',
	},
	sameAs: [
		'https://github.com/Tapawingo',
		'https://www.linkedin.com/in/eirik-dalsegg-teppen-608019206/',
	],
	knowsAbout: [
		'TypeScript',
		'C++',
		'Rust',
		'Go',
		'Python',
		'x86 Assembly',
		'Vue.js',
		'React.js',
		'Qt6',
		'OpenGL',
	],
};
---

<html lang="en" class="no-js">
	<head>
		<!-- Flips no-js -> js before first paint, so global.css's reveal animation (gated on .js) never leaves content stuck invisible if JS fails to run. -->
		<script is:inline>
			document.documentElement.classList.replace('no-js', 'js');
		</script>

		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#060907" />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex" />}

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Eirik Dalsegg Teppen" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Eirik Dalsegg Teppen" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Eirik Dalsegg Teppen, Software Developer"
		/>

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta
			name="twitter:image:alt"
			content="Eirik Dalsegg Teppen, Software Developer"
		/>

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(personSchema)}
		/>
	</head>
	<body>
		<PlasmaBackground />
		<LenisScroll />
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
		<ScrollEffects />
		<PerfOverlay />
	</body>
</html>
